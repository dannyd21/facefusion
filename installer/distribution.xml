<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>FaceFusion</title>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    
    <!-- Installer wizard screens -->
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    
    <choices-outline>
        <line choice="default">
            <line choice="io.facefusion.pkg"/>
        </line>
    </choices-outline>
    
    <choice id="default"/>
    <choice id="io.facefusion.pkg" visible="false">
        <pkg-ref id="io.facefusion.pkg"/>
    </choice>
    
    <pkg-ref id="io.facefusion.pkg" version="3.9.2" onConclusion="none">FaceFusion-component.pkg</pkg-ref>
</installer-gui-script>
