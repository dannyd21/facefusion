#!/bin/sh
# =============================================================================
# Post-installation script for FaceFusion.pkg
# Automatically executed by macOS Installer.app as root
# =============================================================================

APP_PATH="/Applications/FaceFusion.app"

if [ -d "$APP_PATH" ]; then
    chmod -R 755 "$APP_PATH" 2>/dev/null || true
    xattr -cr "$APP_PATH" 2>/dev/null || true
fi

exit 0
